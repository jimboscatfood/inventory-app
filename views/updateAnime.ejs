<!DOCTYPE html>
<html>
  <head>
    <title>Update: <%=locals.animeTitle%></title>
  </head>
  <body>
    <%- include("./partials/errors.ejs")%>
    <form action="/anime/<%= locals.animeId %>/update" method="POST">
      <label
        >Anime Title:
        <input
          type="text"
          name="title"
          value="<%= animeTitle %>"
          required
      /></label><br>
      <%if (locals.allGenres) {%>
      <h3>Genres:</h3>
        <% allGenres.map(genre => {%>
        <label><%= genre.name%><input
          type="checkbox"
          id = "<%=genre.id%>"
          name="genre"
          value="<%= genre.id %>"
          <%= locals.animeGenresId.includes(genre.id)?'checked':"" %>
      /></label><br>
      <%});%>
      <%};%>
      <label>Views: <input type="number" name="views" value="<%=locals.animeViews%>" required></label><br>
      <button type="submit">Update Anime Info</button><br>
    </form>
    <a href="/">Back to home</a>
  </body>
</html>
