<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>
  <a href="/">Back to Home</a><br>
  <a href="/anime/add">Add Anime</a>
  <ul>
    <% if ((locals.allAnime) && (locals.allAnimeGenres)){%>
      <% allAnime.forEach(anime => { %>
        <li>
          Anime ID: <%= anime.id%><br>
          <!-- adding the anime id after the /anime route for the GET request getting the webpage where user can view the specific item -->
          Title: <a href="/anime/<%=anime.id%>"><%= anime.title%></a><br>
          Genre: <ul><% allAnimeGenres.forEach(animeGenre => {%>
            <% if (animeGenre.anime_id === anime.id) {%>
            <!-- adding the genre id after the /genre route for the GET request getting the webpage where user can see list of animes under that specific genre -->
                <li><a href="/genre/<%=animeGenre.genre_id%>"><%=animeGenre.name%></a></li>
            <%}%>
            <%});%>
            </ul>
          Views: <%= anime.views%>
        </li>
      <% }); %>
    <% } %>
  </ul>
</body>
</html>
