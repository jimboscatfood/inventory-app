<!DOCTYPE html>
<html>
<head>
  <title><%= locals.animeTitle %></title>
</head>
<body>
    <h1><%= animeTitle %></h1>
    <p>Anime ID: <%= locals.animeId %><br>
        Genre: <ul><% locals.animeGenres.forEach(genre => {%>
        <li><a href="/genre/<%=genre.genre_id%>"><%=genre.name%></a></li>
            <%});%></ul><br>
          Views: <%= locals.animeViews%>
    </p>
    <a href="/anime/<%=animeId%>/update">Update Item</a>
</body>
</html>
