<!DOCTYPE html>
<html>
<head>
  <title><%= locals.animeTitle %></title>
</head>
<body>
    <h1><%= animeTitle %></h1>
    <p>Anime ID: <%= locals.animeId %><br>
        Genre: <ul><% locals.animeGenres.forEach(genre => {%>
        <li><a href="/genre/<%=genre.genre_id%>"><%=genre.name%></a></li>
            <%});%></ul><br>
          Views: <%= locals.animeViews%>
    </p>
    <a href="/anime/<%=animeId%>/update">Update Anime</a>
    <form action="/anime/<%=animeId%>/delete" method="POST">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this anime?');">Delete Anime</button>
    </form>
</body>
</html>
