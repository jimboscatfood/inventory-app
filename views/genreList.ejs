<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <a href="/">Back to Home</a><br>
  <a href="/genre/add">Add Genre</a>

  <h1><%= title %></h1>
  <ul>
    <% if (locals.allGenres) {%>
      <% allGenres.forEach(genre => { %>
        <li>
          Genre ID: <%= genre.id%><br>
          Genre Name: <a href="/genre/<%=genre.id%>"><%= genre.name%></a><br>
        </li>
        <form action="/genre/<%=genre.id%>/delete" method="POST">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete Genre</button>
        </form>
      <% }); %>
    <% } %>
  </ul>
  
</body>
</html>
