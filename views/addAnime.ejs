<!DOCTYPE html>
<html>
  <head>
    <title>Add Anime</title>
  </head>
  <body>
    <%- include("./partials/errors.ejs")%>
    <form action="/anime/add" method="POST">
      <label
        >Anime Title:
        <input
          type="text"
          name="title"
          required
      /></label><br>
      <%if (locals.allGenres) {%>
      <h3>Genres:</h3>
        <% allGenres.map(genre => {%>
        <label><%= genre.name%><input
          type="checkbox"
          id = "<%=genre.id%>"
          name="genre"
          value="<%= genre.id %>"%>
      /></label><br>
      <%});%>
      <%};%>
      <label>Views: <input type="number" name="views" required></label><br>
      <button type="submit">Add Anime</button><br>
    </form>
    <a href="/">Back to home</a>
  </body>
</html>
